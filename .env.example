# Keys for the optional paid providers. Every one is optional: without it unfaced uses
# the free path and says so. Copy this file to .env in a page folder, in the folder you
# run unfaced from, or in ~/.unfaced/, and fill in only the keys you have.
# The nearest .env wins, and a variable already set in the environment is never replaced.
# Never put keys in page.yaml.

# ElevenLabs voice (providers.voice: elevenlabs). https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=
